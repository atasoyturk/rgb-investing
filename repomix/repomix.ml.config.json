{
  "input": {
    "maxFileSize": 50000000
  },
  "output": {
    "filePath": "artifacts/ml_code.xml",
    "style": "xml"
  },
  "include": [
    "src/**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "artifacts/**",
      "repomix/**",
      "scripts/**",
      "**/__pycache__/**",
      "**/.venv/**",
      "**/venv/**",
      "**/.ipynb_checkpoints/**",
      "**/*.pyc",
      "**/*.pyo",
      "**/*.log",
      "**/*.pkl",
      "**/*.joblib"
    ]
  }
}