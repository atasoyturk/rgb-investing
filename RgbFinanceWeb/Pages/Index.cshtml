@page
@model IndexModel
@{
    ViewData["Title"] = "Signals";
}

<div class="page-container">

    @if (Model.ErrorMessage != null)
    {
        <div class="alert-box error">
            <strong>Connection Error:</strong> @Model.ErrorMessage
            <div style="margin-top:8px; font-size:13px;">Data may be loading, please refresh the page (F5).</div>
        </div>
    }

    @if (Model.Health != null && Model.Health.ModelLoaded)
    {
        <div class="alert-box info">
            <strong>RGB Model is Ready</strong> 
        </div>
    }

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-label">Total Stock</div>
            <div class="stat-value">
                @(Model.AllSignals.Count)
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-label">BUY Signal</div>
            <div class="stat-value buy">
                @(Model.AllSignals.Count(s => s.Signal == "BUY"))
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-label">SELL Signal</div>
            <div class="stat-value sell">
                @(Model.AllSignals.Count(s => s.Signal == "SELL"))
            </div>
        </div>
        <div class="stat-card">
        <div class="stat-label">Model Accuracy</div>
        <div class="stat-value accent" style="font-size:14px; line-height:1.4;">
            @if (Model.SignalsTable?.ModelF1 != null)
            {
                var f1 = Model.SignalsTable.ModelF1.Value;
                if (f1 >= 0.55)
                {
                    <span style="color:var(--buy)">Strong</span>
                    <div style="font-size:11px; color:var(--text2); margin-top:4px;">Model signals are reliable</div>
                }
                else if (f1 >= 0.45)
                {
                    <span style="color:#f39c12">Moderate</span>
                    <div style="font-size:11px; color:var(--text2); margin-top:4px;">Use with caution</div>
                }
                else
                {
                    <span style="color:var(--sell)">Weak</span>
                    <div style="font-size:11px; color:var(--text2); margin-top:4px;">Low confidence signals</div>
                }
            }
            else
            {
                <span>—</span>
            }
        </div>
    </div>
    </div>

    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <div class="section-title" style="margin-bottom:0;">Market</div>
        <a href="?market=SP500" class="btn-detail @(Model.SelectedMarket == "SP500" ? "active" : "")">S&P 500</a>
        <a href="?market=NASDAQ100" class="btn-detail @(Model.SelectedMarket == "NASDAQ100" ? "active" : "")">NASDAQ 100</a>
        <a href="?market=BIST100" class="btn-detail @(Model.SelectedMarket == "BIST100" ? "active" : "")">BIST 100</a>
        <a href="?market=@Model.SelectedMarket&signal=@Model.SelectedSignal&minTrust=@Model.MinTrust&showPortfolio=@(!Model.ShowPortfolio)" 
            class="btn-detail @(Model.ShowPortfolio ? "active" : "")" style="margin-left:8px;">
                @(Model.ShowPortfolio ? "★ Portfolio" : "☆ Portfolio")
        </a>
    </div>

    <div style="display:flex; align-items:center; gap:12px; margin-bottom:24px; flex-wrap:wrap;">
        <div style="display:flex; gap:8px;">
            <a href="?market=@Model.SelectedMarket&signal=ALL&minTrust=@Model.MinTrust" 
            class="btn-detail @(Model.SelectedSignal == "ALL" ? "active" : "")">All</a>
            <a href="?market=@Model.SelectedMarket&signal=BUY&minTrust=@Model.MinTrust" 
            class="btn-detail @(Model.SelectedSignal == "BUY" ? "active" : "")">▲ BUY</a>
            <a href="?market=@Model.SelectedMarket&signal=SELL&minTrust=@Model.MinTrust" 
            class="btn-detail @(Model.SelectedSignal == "SELL" ? "active" : "")">▼ SELL</a>
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:13px; color:var(--text2);">Min Trust:</span>
            <a href="?market=@Model.SelectedMarket&signal=@Model.SelectedSignal&minTrust=0" 
            class="btn-detail @(Model.MinTrust == 0 ? "active" : "")">All</a>
            <a href="?market=@Model.SelectedMarket&signal=@Model.SelectedSignal&minTrust=60" 
            class="btn-detail @(Model.MinTrust == 60 ? "active" : "")">60%+</a>
            <a href="?market=@Model.SelectedMarket&signal=@Model.SelectedSignal&minTrust=70" 
            class="btn-detail @(Model.MinTrust == 70 ? "active" : "")">70%+</a>
            <a href="?market=@Model.SelectedMarket&signal=@Model.SelectedSignal&minTrust=80" 
            class="btn-detail @(Model.MinTrust == 80 ? "active" : "")">80%+</a>
            
        </div>
        
        <div>
            <form method="get" style="display:inline;">
                <input type="hidden" name="market" value="@Model.SelectedMarket" />
                <input type="hidden" name="signal" value="@Model.SelectedSignal" />
                <input type="hidden" name="minTrust" value="@Model.MinTrust" />
                <input type="hidden" name="showPortfolio" value="@Model.ShowPortfolio" />
                <input type="text" name="search" value="@Model.Search" placeholder="Search ticker..." 
                    class="form-input" style="width:180px; padding:5px 10px; font-size:13px;" />
                <button type="submit" class="btn-detail" style="padding:5px 10px;">Search</button>
            </form>
        </div>
        
        <div style="font-size:12px; color:var(--text2); max-width:320px;">
            <strong>What is Trust?</strong> Indicates how confident the model is in this signal. A signal strength of 70% or higher means that approximately 50% is unclear.
        </div>
        @if (Model.ThresholdLabel != null)
        {
            <div class="alert-box info" style="margin-bottom:16px; font-size:13px;">
                <strong>5 business days ahead forecast</strong>, @Model.ThresholdLabel
            </div>
        }

        <div class="alert-box info" style="margin-bottom:16px; font-size:13px;">
            <strong>Last Update</strong>: Every Friday 18:00 (BIST) / 00:00 (SP500, NASDAQ)
        </div>
    </div>

    <div class="section-title">Signal Table</div>

    @if (Model.SignalsTable != null && Model.SignalsTable.Signals.Any())
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Stock</th>
                        <th>Signal</th>
                        <th>Trust</th>
                        <th>Last Close Price</th>
                        <th>Change</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.SignalsTable.Signals)
                    {
                        <tr class="signal-table-row" data-ticker="@s.Ticker">
                            <td>
                                <div class="ticker-name">@s.Ticker</div>
                                @if (!s.InTrainingSet)
                                {
                                    <span class="out-of-training">Out of Training</span>
                                }
                            </td>
                            <td>
                                @if (s.Signal == "BUY")
                                {
                                    <span class="signal-badge buy">▲ BUY</span>
                                }
                                else if (s.Signal == "SELL")
                                {
                                    <span class="signal-badge sell">▼ SELL</span>
                                }
                                else
                                {
                                    <span class="signal-badge error">@s.Signal</span>
                                }
                            </td>
                            <td>
                                <div class="conf-wrap">
                                    <div class="conf-bar">
                                        <div class="conf-fill @(s.Signal == "BUY" ? "buy" : "sell")"
                                             style="width: @((s.Confidence * 100).ToString("F0"))%">
                                        </div>
                                    </div>
                                    <span class="conf-text">@s.Confidence.ToString("P0")</span>
                                </div>
                            </td>
                            <td>
                                @if (s.LastPrice.HasValue)
                                {
                                    <span>@s.Currency@s.LastPrice.Value.ToString("F2")</span>

                                }
                                else
                                {
                                    <span style="color:var(--text2)">—</span>
                                }
                            </td>
                            <td>
                                @if (s.PriceChange.HasValue)
                                {
                                    var color = s.PriceChange.Value >= 0 ? "var(--buy)" : "var(--sell)";
                                    var sign = s.PriceChange.Value >= 0 ? "+" : "";
                                    <span style="color:@color; font-weight:600;">@sign@s.PriceChange.Value.ToString("F1")%</span>
                                }
                                else
                                {
                                    <span style="color:var(--text2)">—</span>
                                }
                            </td>

                            <td>
                                <a href="/Detail?ticker=@s.Ticker&market=@Model.SelectedMarket" class="btn-detail">Examine</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.ErrorMessage == null)
    {
        <div class="alert-box info">Signal cannot be found.</div>
    }

    <div style="display:flex; gap:8px; margin-top:16px; justify-content:center;">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a href="?market=@Model.SelectedMarket&signal=@Model.SelectedSignal&minTrust=@Model.MinTrust&showPortfolio=@Model.ShowPortfolio&search=@Model.Search&page=@i"
            class="btn-detail @(Model.CurrentPage == i ? "active" : "")">@i</a>
        }
    </div>
</div>